# ==============================================================================
# Personal RAG Assistant - Environment Configuration
# Copy this file to .env and customize for your deployment
# ==============================================================================

# Application Environment
ENVIRONMENT=development
APP_NAME="Personal RAG Assistant"
APP_VERSION="1.0.0"
DEBUG=true
LOG_LEVEL=INFO

# Security & Authentication
# Generate a strong 32+ character secret: openssl rand -hex 32
SECRET_KEY=change-me-to-a-super-secret-random-32-byte-hex-string-for-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth (Optional - leave empty for email/password only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# Database Configuration
# PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/rag_assistant
# SQLite (Local zero-config dev default): sqlite+aiosqlite:///./data/rag_assistant.db
DATABASE_URL=sqlite+aiosqlite:///./data/rag_assistant.db

# Redis Caching & Rate Limiting (Optional - in-memory fallback enabled if blank or offline)
REDIS_URL=redis://localhost:6379/0

# Vector Database (Qdrant)
# Local Docker: http://localhost:6333
# Qdrant Cloud: https://xxxx.eu-central.aws.cloud.qdrant.io:6333 (requires QDRANT_API_KEY)
# Local In-Memory / File Fallback: leave empty or :memory:
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=personal_rag_documents

# Embeddings Model Configuration
# Available providers: sentence-transformers (local/free), gemini, openai
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

# LLM Provider Configuration
# Primary provider: gemini | groq | openai | ollama
DEFAULT_LLM_PROVIDER=gemini
DEFAULT_LLM_MODEL=gemini-3.8-flash
DEFAULT_TEMPERATURE=0.2
DEFAULT_MAX_TOKENS=2048

# LLM API Keys (Set the ones you use; Gemini and Groq have generous free tiers)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# RAG Retrieval Hyperparameters
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.15
RAG_ENABLE_HYBRID_SEARCH=true
RAG_BM25_WEIGHT=0.3
RAG_DENSE_WEIGHT=0.7
RAG_ENABLE_RERANKER=false
RAG_RERANKER_MODEL=BAAI/bge-reranker-base
RAG_ENABLE_HYDE=false
RAG_ENABLE_MULTI_QUERY=false

# Document Chunking Settings
DEFAULT_CHUNK_SIZE=600
DEFAULT_CHUNK_OVERLAP=100
MAX_UPLOAD_SIZE_MB=50

# CORS & Server Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://personal-rag-assistant.vercel.app"]

# Frontend Next.js Public Variables (in frontend/.env)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME="Personal RAG Assistant"
